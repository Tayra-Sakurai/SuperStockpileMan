<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="SuperStockpileMan.TreeViewTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:SuperStockpileMan.Bus.Models">
    <DataTemplate
        x:Key="CategoryTreeViewTemplate"
        x:DataType="models:Category">
        <muxc:TreeViewItem ItemsSource="{Binding Children}">
            <muxc:TreeViewItem.Content>
                <controls:DataRow>
                    <TextBlock Text="{Binding Id}"/>
                    <TextBlock Text="{Binding Name}"/>
                </controls:DataRow>
            </muxc:TreeViewItem.Content>
        </muxc:TreeViewItem>
    </DataTemplate>

    <DataTemplate
        x:Key="SmallestCategoryTreeViewTemplate"
        x:DataType="models:SmallestCategory">
        <muxc:TreeViewItem>
            <muxc:TreeViewItem.Content>
                <controls:DataRow>
                    <TextBlock Text="{Binding Id}"/>
                    <TextBlock Text="{Binding Name}"/>
                </controls:DataRow>
            </muxc:TreeViewItem.Content>
        </muxc:TreeViewItem>
    </DataTemplate>

    <DataTemplate
        x:Key="InstantTreeViewCategory"
        x:DataType="models:Category">
        <TreeViewItem
            Content="{Binding Name}"
            ItemsSource="{Binding Children}"/>
    </DataTemplate>

    <DataTemplate
        x:Key="InstantTreeViewSmallestCategory"
        x:DataType="models:SmallestCategory">
        <TreeViewItem
            Content="{Binding Name}"/>
    </DataTemplate>

    <local:CategoryTreeViewDataTemplateSelector
        CategoryTemplate="{StaticResource CategoryTreeViewTemplate}"
        SmallestCategoryTemplate="{StaticResource SmallestCategoryTreeViewTemplate}"
        x:Key="CategoryTreeViewDataTemplateSelector"/>

    <local:CategoryTreeViewDataTemplateSelector
        CategoryTemplate="{StaticResource InstantTreeViewCategory}"
        SmallestCategoryTemplate="{StaticResource InstantTreeViewSmallestCategory}"
        x:Key="InstantCategoryTreeViewTemplateSelector"/>
</ResourceDictionary>
