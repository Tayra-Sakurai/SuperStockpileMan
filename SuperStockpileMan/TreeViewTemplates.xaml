<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="SuperStockpileMan.TreeViewTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:SuperStockpileMan.Bus.Models">
    <DataTemplate
        x:Key="CategoryTreeViewTemplate"
        x:DataType="models:Category">
        <muxc:TreeViewItem ItemsSource="{x:Bind Children}">
            <muxc:TreeViewItem.Content>
                <Grid
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                </Grid>
            </muxc:TreeViewItem.Content>
        </muxc:TreeViewItem>
    </DataTemplate>

    <DataTemplate
        x:Key="SmallestCategoryTreeViewTemplate"
        x:DataType="models:SmallestCategory">
        <muxc:TreeViewItem>
            <muxc:TreeViewItem.Content>
                <Grid
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                </Grid>
            </muxc:TreeViewItem.Content>
        </muxc:TreeViewItem>
    </DataTemplate>

    <DataTemplate
        x:Key="InstantTreeViewCategory"
        x:DataType="models:Category">
        <TreeViewItem
            Content="{x:Bind Name}"
            ItemsSource="{x:Bind Children}"/>
    </DataTemplate>

    <DataTemplate
        x:Key="InstantTreeViewSmallestCategory"
        x:DataType="models:SmallestCategory">
        <TreeViewItem
            Content="{x:Bind Name}"/>
    </DataTemplate>

    <local:CategoryTreeViewDataTemplateSelector
        CategoryTemplate="{StaticResource CategoryTreeViewTemplate}"
        SmallestCategoryTemplate="{StaticResource SmallestCategoryTreeViewTemplate}"
        x:Key="CategoryTreeViewDataTemplateSelector"/>

    <local:CategoryTreeViewDataTemplateSelector
        CategoryTemplate="{StaticResource InstantTreeViewCategory}"
        SmallestCategoryTemplate="{StaticResource InstantTreeViewSmallestCategory}"
        x:Key="InstantCategoryTreeViewTemplateSelector"/>
</ResourceDictionary>
