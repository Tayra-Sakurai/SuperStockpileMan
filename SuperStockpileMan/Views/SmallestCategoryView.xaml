<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperStockpileMan.Views.SmallestCategoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local2="using:SuperStockpileMan.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            VerticalAlignment="Top"
            x:Uid="SmallestCategoryDescription"/>

        <local2:ValidationTextBox
            Grid.Row="1"
            x:Uid="NameBox"
            PlaceholderForeground="{ThemeResource TextBoxPlaceholderTextThemeBrush}"
            PropertyName="Name"
            ValidationErrorInfo="{x:Bind viewModel}"/>

        <CommandBar
            DefaultLabelPosition="Collapsed"
            Grid.Row="2">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveBtn"
                Command="{x:Bind viewModel.SaveCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RmBtn">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RmMsg"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                x:Uid="RmConfirm"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind viewModel.RemoveCommand}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
