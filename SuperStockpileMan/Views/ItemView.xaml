<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperStockpileMan.Views.ItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local2="using:SuperStockpileMan.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.ColumnSpan="3"
            x:Uid="ItemDescription"
            Style="{StaticResource BodyTextBlockStyle}"
            VerticalAlignment="Top"/>

        <local2:ValidationTextBox
            Grid.ColumnSpan="3"
            Grid.Row="1"
            ValidationErrorInfo="{x:Bind viewModel}"
            PropertyName="Name"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            x:Uid="NameBox"/>

        <TextBox
            Grid.ColumnSpan="3"
            Grid.Row="2"
            AcceptsReturn="True"
            x:Uid="DescriptionBox"
            Text="{x:Bind viewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <ComboBox
            x:Uid="SmallestCategoriesSelector"
            Grid.Row="3"
            ItemsSource="{x:Bind viewModel.SmallestCategories}"
            SelectedItem="{x:Bind viewModel.SmallestCategory, Mode=TwoWay}"
            ItemTemplate="{StaticResource SmallCategoryComboBoxTemplate}"/>

        <ComboBox
            x:Uid="LocationComboBox"
            Grid.Row="3"
            Grid.Column="1"
            ItemsSource="{x:Bind viewModel.Locations}"
            SelectedItem="{x:Bind viewModel.Location}"
            ItemTemplate="{StaticResource LocationComboBoxTemplate}"/>

        <CalendarDatePicker
            x:Uid="PurchaseDatePicker"
            Grid.Row="4"
            Grid.Column="0"
            Date="{x:Bind viewModel.PurchaseDate, Mode=TwoWay}"/>

        <CalendarDatePicker
            x:Uid="LifePicker"
            Grid.Row="4"
            Grid.Column="1"
            Date="{x:Bind viewModel.DueDate, Mode=TwoWay}"/>

        <CommandBar
            Grid.ColumnSpan="3"
            Grid.Row="5"
            DefaultLabelPosition="Collapsed">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveBtn"
                Command="{x:Bind viewModel.SaveCommand}"/>
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncBtn"
                Command="{x:Bind viewModel.LoadCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RmBtn">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RmMsg"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                x:Uid="RmConfirm"
                                Command="{x:Bind viewModel.RemoveCommand}"
                                Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
