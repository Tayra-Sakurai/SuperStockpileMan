<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperStockpileMan.Views.LocationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local2="using:SuperStockpileMan.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition
                Height="Auto"
                MaxHeight="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            VerticalAlignment="Top"
            x:Uid="LocationDescription"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <local2:ValidationTextBox
            Grid.Row="1"
            PropertyName="Name"
            x:Uid="NameBox"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ValidationErrorInfo="{x:Bind viewModel}"/>


        <StackPanel
            Orientation="Horizontal"
            Grid.Row="2">
            <TreeView
                x:Name="CategoriesView"
                ItemsSource="{x:Bind viewModel.Categories}"
                SelectionMode="Single"
                ItemTemplateSelector="{StaticResource InstantCategoryTreeViewTemplateSelector}"/>

            <AppBarButton
                Icon="Add"
                x:Uid="AddBtn"
                Command="{x:Bind viewModel.AddRelatedCategoryCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=CategoriesView}"/>
        </StackPanel>

        <CommandBar
            Grid.Row="3"
            DefaultLabelPosition="Collapsed">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveBtn"
                Command="{x:Bind viewModel.SaveCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RmBtn">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RmMsg"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                x:Uid="RmConfirm"
                                Command="{x:Bind viewModel.RemoveCommand}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncBtn"
                Command="{x:Bind viewModel.LoadCommand}"/>
        </CommandBar>
    </Grid>
</Page>
