<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperStockpileMan.Views.CategoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local2="using:SuperStockpileMan.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MaxHeight="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.ColumnSpan="3"
            x:Uid="CategoryDetailDescription"
            VerticalAlignment="Top"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <local2:ValidationTextBox
            Grid.Row="1"
            Grid.ColumnSpan="3"
            x:Uid="NameBox"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
            PlaceholderForeground="{ThemeResource TextBoxPlaceholderTextThemeBrush}"
            ValidationErrorInfo="{x:Bind viewModel, Mode=OneWay}"
            PropertyName="Name"/>

        <TreeView
            Grid.Row="2"
            ItemsSource="{x:Bind viewModel.Children}"
            ItemTemplateSelector="{StaticResource InstantCategoryTreeViewTemplateSelector}"/>

        <ComboBox
            x:Uid="ParentCategoryBox"
            Grid.Row="2"
            Grid.Column="1"
            ItemsSource="{x:Bind viewModel.Categories}"
            ItemTemplate="{StaticResource CategoryComboBoxTemplate}"
            SelectedItem="{x:Bind viewModel.Parent, Mode=TwoWay}"/>

        <CommandBar
            DefaultLabelPosition="Collapsed"
            Grid.Row="3">
            <AppBarButton
                Icon="Save"
                x:Uid="SaveBtn"
                Command="{x:Bind viewModel.SaveCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RmBtn">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RmMsg"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                x:Uid="RmConfirm"
                                Command="{x:Bind viewModel.RemoveCommand}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
