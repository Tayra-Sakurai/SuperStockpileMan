<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperStockpileMan.Views.LocationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="LocationsDescription"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <ListView
            Grid.Row="1"
            x:Name="SuperListView"
            ItemsSource="{x:Bind viewModel.Locations}"
            Style="{StaticResource LocationsListViewStyle}"/>

        <CommandBar
            Grid.Row="2"
            DefaultLabelPosition="Collapsed">
            <AppBarButton
                Icon="Add"
                x:Uid="AddBtn"
                Command="{x:Bind viewModel.AddCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RmBtn">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                x:Uid="RmMsg"
                                Style="{StaticResource BaseTextBlockStyle}"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                x:Uid="RmConfirm"
                                Command="{x:Bind viewModel.RemoveCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=SuperListView}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncBtn"
                Command="{x:Bind viewModel.LoadCommand}"/>
            <AppBarButton
                Icon="Preview"
                x:Uid="DtlBtn"
                Command="{x:Bind viewModel.InvokeCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=SuperListView}"/>
        </CommandBar>
    </Grid>
</Page>
