<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SuperStockpileMan.Views.CategoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SuperStockpileMan.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SuperStockpileMan.Bus.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            x:Uid="DescCat"/>

        <controls:HeaderedTreeView
            Grid.Row="1"
            ItemsSource="{x:Bind categoriesViewModel.Categories}"
            ItemTemplateSelector="{StaticResource CategoryTreeViewDataTemplateSelector}"
            x:Name="TreeView">
            <controls:HeaderedTreeView.Header>
                <controls:DataTable>
                    <controls:DataColumn
                        x:Uid="IdColumn"/>
                    <controls:DataColumn
                        x:Uid="NameColumn"
                        DesiredWidth="*"/>
                </controls:DataTable>
            </controls:HeaderedTreeView.Header>
        </controls:HeaderedTreeView>

        <Border
            Grid.Row="2">
            <StackPanel>
                <TextBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"/>
            </StackPanel>
        </Border>

        <CommandBar
            Grid.Row="3"
            DefaultLabelPosition="Collapsed">
            <AppBarButton
                Icon="Add"
                x:Uid="AddBtnC"
                Command="{x:Bind categoriesViewModel.AddCategoryCommand}"/>
            <AppBarButton
                Icon="Add"
                x:Uid="AddBtnCh"
                Command="{x:Bind categoriesViewModel.AddChildCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=TreeView}"/>
            <AppBarButton
                Icon="Add"
                x:Uid="AddBtnS"
                Command="{x:Bind categoriesViewModel.AddSmallestCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=TreeView}"/>
            <AppBarButton
                Icon="Add"
                x:Uid="AddBtnP"
                Command="{x:Bind categoriesViewModel.AddParentCategoryCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=TreeView}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="RmBtn">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource BaseTextBlockStyle}"
                                x:Uid="RmMsg"/>
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                x:Uid="RmConfirm"
                                Command="{x:Bind categoriesViewModel.RemoveCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=TreeView}"/>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncBtn"
                Command="{x:Bind categoriesViewModel.LoadCommand}"/>
            <AppBarButton
                Icon="Go"
                x:Uid="SrchBtn"
                Command="{x:Bind categoriesViewModel.SearchCommand}"
                CommandParameter="{Binding Text, ElementName=SearchBox}"/>
            <AppBarButton
                Icon="Go"
                x:Uid="DtlBtn"
                Command="{x:Bind categoriesViewModel.DetailCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=TreeView}"/>
        </CommandBar>
    </Grid>
</Page>
